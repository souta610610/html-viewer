{
  "id": "./html-viewer.html",
  "name": "HTML Viewer",
  "short_name": "HTML Viewer",
  "description": "HTML ファイルを開いて表示するビューアー",
  "lang": "ja",
  "start_url": "./html-viewer.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#e8ecf1",
  "theme_color": "#e8ecf1",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": ["text/html", ".html", ".htm"]
        }
      ]
    }
  }
}
